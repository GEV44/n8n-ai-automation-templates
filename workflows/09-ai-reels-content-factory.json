{
  "name": "09 AI Reels Content Factory - Trends to Scripts to Content Calendar",
  "nodes": [
    {
      "parameters": {
        "content": "Runs every morning. Reads Google Trends and one niche RSS feed (replace the URLs and geo), the LLM writes 3 short-video scripts with hooks tuned to your niche, they are saved to the Calendar sheet (columns: date, topic, hook, script, cta, hashtags, status, audio_url) and the owner gets a Telegram digest. Enable the Text to Speech node and point it at your TTS provider if you want voice-over audio; it is disabled by default.",
        "width": 620,
        "height": 210
      },
      "id": "ffdf14f7-e025-5cab-a7f7-b2a530cf6b66",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "f9af88ac-3c37-5ad5-80b3-8268e48433ad",
      "name": "Every Morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "url": "https://trends.google.com/trending/rss?geo=US",
        "options": {}
      },
      "id": "f146949d-eefb-531d-a595-9850ae046386",
      "name": "Google Trends RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://example.com/niche-feed.xml",
        "options": {}
      },
      "id": "14e8f6dc-a22c-52c6-b80c-1e2f3b9b45b7",
      "name": "Niche RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [
        240,
        220
      ]
    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "id": "b605683c-f260-5810-8e90-d61546b77048",
      "name": "Combine Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const seen = new Set();\nconst topics = $input.all().map(i => (i.json.title || '').trim()).filter(t => t && !seen.has(t.toLowerCase()) && seen.add(t.toLowerCase())).slice(0, 12);\nreturn [{ json: { topics: topics.join('\\n'), today: new Date().toISOString().slice(0, 10) } }];"
      },
      "id": "51866647-9b11-5556-acbe-0bfa6c7435ca",
      "name": "Pick Topics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.topics }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a short-form video writer for a small business. From the trending topics, choose the 3 that fit a small business audience and write one vertical-video script for each: a hook of at most 12 words for the first 2 seconds, a spoken script of 60 to 90 words, a one-line call to action and 4 hashtags. Plain, spoken language, no clickbait claims, no invented statistics. Return exactly 3 scripts."
            }
          ]
        },
        "hasOutputParser": true
      },
      "id": "68fce427-33e5-5ccf-a220-1136a4895f87",
      "name": "Write Scripts",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        960,
        100
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "options": {
          "temperature": 0.7
        }
      },
      "id": "e19dca02-7d77-5054-907a-9d5b7ebbfdf9",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        960,
        320
      ],
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"scripts\": [\n    {\n      \"topic\": \"Winter heating costs\",\n      \"hook\": \"Your heating bill has a secret\",\n      \"script\": \"Spoken script here\",\n      \"cta\": \"Follow for more\",\n      \"hashtags\": \"#tips #home #winter #saving\"\n    }\n  ]\n}"
      },
      "id": "3eeb575a-b510-5951-92c4-0a0f5a9d158f",
      "name": "Scripts Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1160,
        320
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const day = $('Pick Topics').first().json.today;\nreturn $input.first().json.output.scripts.slice(0, 3).map((s, i) => {\n  const d = new Date(day); d.setDate(d.getDate() + i + 1);\n  return { json: { date: d.toISOString().slice(0, 10), topic: s.topic, hook: s.hook, script: s.script, cta: s.cta, hashtags: s.hashtags, status: 'draft' } };\n});"
      },
      "id": "7665237b-83b3-5938-952e-0cfaad5668a1",
      "name": "Split Scripts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        100
      ]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Calendar",
          "mode": "name"
        },
        "options": {},
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "date": "={{ $json.date }}",
            "topic": "={{ $json.topic }}",
            "hook": "={{ $json.hook }}",
            "script": "={{ $json.script }}",
            "cta": "={{ $json.cta }}",
            "hashtags": "={{ $json.hashtags }}",
            "status": "={{ $json.status }}"
          },
          "matchingColumns": [],
          "schema": []
        }
      },
      "id": "d45968b2-6d26-595e-bdf6-3e6ade655cb1",
      "name": "Save to Calendar",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1440,
        100
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://example.com/tts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $('Split Scripts').item.json.script, voice: 'YOUR_VOICE_ID' }) }}",
        "options": {}
      },
      "id": "4a4a7a96-94bc-5f5a-9255-3577cc785b6f",
      "name": "Text to Speech (optional)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "TTS provider key"
        }
      },
      "disabled": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $('Split Scripts').all().map(i => i.json);\nconst text = 'Content plan ready\\n\\n' + items.map((s, i) => `${i + 1}. ${s.date} - ${s.topic}\\nHook: ${s.hook}\\n${s.cta}`).join('\\n\\n') + '\\n\\nFull scripts are in the Calendar sheet.';\nreturn [{ json: { text } }];"
      },
      "id": "65f11a02-3494-5595-b204-62ef71650166",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        100
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "94d780a6-f3f7-577e-b5b3-485f471a8a96",
      "name": "Send Digest",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2160,
        100
      ],
      "credentials": {
        "telegramApi": {
          "name": "Telegram bot"
        }
      }
    }
  ],
  "connections": {
