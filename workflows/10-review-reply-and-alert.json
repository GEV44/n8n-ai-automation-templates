{
  "name": "10 Review Reply and Alert - Sentiment, Drafted Reply, Weekly Summary",
  "nodes": [
    {
      "parameters": {
        "content": "Polls the Google Business Profile reviews endpoint every 30 minutes (replace the URL placeholders with your account and location IDs and use an OAuth2 credential). Only reviews newer than the last run are processed. The LLM tags sentiment and drafts a reply in the review's language; every review is saved to the Reviews sheet (columns: review_id, author, stars, review, sentiment, topic, language, draft_reply, created_at); negatives alert the owner in Telegram at once with the draft. A Monday branch sends the weekly summary.",
        "width": 620,
        "height": 230
      },
      "id": "5df92e31-8a80-5fd4-bdaf-e850ede3d697",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -320
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
