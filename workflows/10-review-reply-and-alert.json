        "url": "https://mybusiness.googleapis.com/v4/accounts/YOUR_ACCOUNT_ID/locations/YOUR_LOCATION_ID/reviews",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "orderBy",
              "value": "updateTime desc"
            },
            {
              "name": "pageSize",
              "value": "20"
            }
          ]
        },
        "options": {}
      },
      "id": "1bffc938-523f-5882-95f1-ce829f85b3b6",
      "name": "Fetch Google Reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "credentials": {
        "oAuth2Api": {
          "name": "Google Business Profile OAuth2"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst last = store.lastSeen || '1970-01-01T00:00:00Z';\nconst stars = { ONE: 1, TWO: 2, THREE: 3, FOUR: 4, FIVE: 5 };\nconst fresh = ($input.first().json.reviews || []).filter(r => r.createTime > last).sort((a, b) => a.createTime.localeCompare(b.createTime));\nif (fresh.length) store.lastSeen = fresh[fresh.length - 1].createTime;\nreturn fresh.map(r => ({ json: { review_id: r.reviewId, author: r.reviewer?.displayName || 'Anonymous', stars: stars[r.starRating] || 0, review: r.comment || '', created_at: r.createTime } }));"
      },
      "id": "e1233f62-a063-5fe5-93f1-8ee208899675",
      "name": "Only New Reviews",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Stars: {{ $json.stars }}\nReview: {{ $json.review }}",
        "messages": {
          "messageValues": [
            {
              "message": "You handle Google reviews for a small business. Return sentiment (positive, neutral or negative; use the star rating as a hint when the text is empty), topic (service, price, quality, delivery, staff or other), language (ISO code of the review text, en if empty) and draft_reply: a short, warm, specific reply of 2 to 4 sentences written in the review's language. For negative reviews apologise sincerely, do not argue or offer refunds, and invite the customer to contact the business directly. Do not invent facts."
            }
          ]
        },
        "hasOutputParser": true
      },
