    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const since = Date.now() - 7 * 24 * 3600 * 1000;\nconst rows = $input.all().map(i => i.json).filter(r => new Date(r.created_at).getTime() >= since);\nconst count = (key) => rows.reduce((a, r) => { a[r[key]] = (a[r[key]] || 0) + 1; return a; }, {});\nconst avg = rows.length ? rows.reduce((s, r) => s + Number(r.stars || 0), 0) / rows.length : 0;\nreturn [{ json: { total: rows.length, avg_stars: Math.round(avg * 10) / 10, sentiment: count('sentiment'), topics: count('topic'), negatives: rows.filter(r => r.sentiment === 'negative').slice(0, 8).map(r => r.review) } }];"
      },
