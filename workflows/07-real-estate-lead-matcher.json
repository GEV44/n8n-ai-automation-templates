            "request": "={{ $('Match Listings').item.json.request }}",
            "contact": "={{ $('Match Listings').item.json.contact }}",
            "criteria": "={{ $('Match Listings').item.json.criteria }}",
            "match_count": "={{ $('Match Listings').item.json.match_count }}",
            "match_ids": "={{ $('Match Listings').item.json.match_ids }}",
            "matched_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": []
        }
      },
      "id": "72872244-a406-5ae6-8c35-048aa75b400d",
      "name": "Log Result",
