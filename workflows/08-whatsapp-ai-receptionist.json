{
  "name": "08 WhatsApp AI Receptionist - FAQ, Calendar Booking, Human Handoff",
  "nodes": [
    {
      "parameters": {
        "content": "WhatsApp Cloud API: set the callback URL of the Meta app to this workflow's production webhook path /whatsapp (GET verifies, POST receives) and use the same verify token in WhatsApp Verify Reply. Replace YOUR_PHONE_NUMBER_ID, the knowledge doc URL (plain text, paragraphs separated by blank lines), the calendar and YOUR_STAFF_CHAT_ID. Retrieval is keyword scoring over paragraphs; swap it for a vector store node if the doc is large. Handoff keywords live in Extract Message.",
        "width": 640,
        "height": 220
      },
      "id": "0fe8194e-5860-5aa2-9632-d388475b8fce",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -320
      ]
    },
