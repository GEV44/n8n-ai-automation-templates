    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const v = $json.body?.entry?.[0]?.changes?.[0]?.value;\nconst m = v?.messages?.[0];\nif (!m || m.type !== 'text') return [];\nconst text = m.text.body;\nconst handoff = /(human|agent|manager|person|оператор|человек|менеджер|живой|մարդ|օպերատոր|մենեջեր)/i.test(text);\nconst lang = /[\\u0530-\\u058F]/.test(text) ? 'hy' : /[\\u0400-\\u04FF]/.test(text) ? 'ru' : 'en';\nconst handoffReply = { hy: 'Ձեր հարցը փոխանցեցի աշխատակցին, շուտով կպատասխանի։', ru: 'Передал ваш вопрос сотруднику, он скоро ответит.', en: 'I passed your message to a team member, they will reply shortly.' }[lang];\nreturn [{ json: { from: m.from, name: v.contacts?.[0]?.profile?.name || '', text, handoff, handoff_reply: handoffReply, phone_number_id: v.metadata?.phone_number_id || 'YOUR_PHONE_NUMBER_ID' } }];"
      },
      "id": "b1dbdf22-1d2d-5e8c-9217-388d36aab62f",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "ca6a4100-ac56-52e9-a614-2572e741e108",
              "leftValue": "={{ $json.handoff }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c8ef4677-b3f5-5bc5-8c13-41dbc45c20bd",
