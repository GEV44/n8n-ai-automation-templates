      "id": "859ef810-8a69-56e9-92be-2fbae9345d0b",
      "name": "WhatsApp Messages (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        100
      ],
      "webhookId": "f3dd20ed-182a-52d9-ae86-9d9409a01978"
