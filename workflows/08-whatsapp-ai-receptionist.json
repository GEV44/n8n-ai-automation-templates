    {
      "parameters": {
        "method": "GET",
        "url": "https://example.com/knowledge.txt",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "0d98217a-2a3b-5a70-9bf8-88b04a22c9f5",
      "name": "Fetch Knowledge Doc",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        220
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const q = $('Extract Message').first().json.text;\nconst doc = String($input.first().json.data || '');\nconst tok = s => (String(s).toLowerCase().match(/[\\p{L}\\p{N}]{3,}/gu) || []);\nconst qt = new Set(tok(q));\nconst paras = doc.split(/\\n\\s*\\n/).map(p => p.trim()).filter(Boolean);\nconst top = paras.map(p => ({ p, s: tok(p).filter(t => qt.has(t)).length })).sort((a, b) => b.s - a.s).slice(0, 3).filter(x => x.s > 0).map(x => x.p);\nconst now = new Date().toISOString();\nreturn [{ json: { question: q, context: top.join('\\n\\n') || '(nothing relevant found)', now } }];"
      },
      "id": "e8f80f33-ee68-56c2-bb4e-85ab55722578",
      "name": "Retrieve Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        220
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.question }}",
        "messages": {
          "messageValues": [
            {
              "message": "=You are the WhatsApp receptionist of a business. Reply in the customer's language (Armenian, Russian or English), briefly and politely. Answer ONLY from the knowledge below; if it is not there, say a team member will follow up and never invent prices, hours or policies. Set intent to booking only when the customer asks to book; fill start and end (ISO 8601, 60 minutes by default, current time is {{ $json.now }}) only if both date and time are known, else leave them empty and ask for what is missing in reply. reply is what you send if the slot is free; reply_if_busy is what you send if the slot is taken (offer to pick another time).\n\nKnowledge:\n{{ $json.context }}"
            }
          ]
        },
        "hasOutputParser": true
      },
